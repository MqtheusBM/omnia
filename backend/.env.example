# ──────────────────────────────────────────────
# Omnia Backend — Variáveis de Ambiente
# Copie para .env e preencha com seus valores
# ──────────────────────────────────────────────

# ── Gemini ───────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# Provedor de IA ativo (openai ou gemini)
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-6.1-sol

# ── Google Cloud ─────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us
GOOGLE_APPLICATION_CREDENTIALS=C:\caminho\para\sua\service-account.json
# Para deploy sem arquivo local (ex.: Vercel), configure o JSON como variável secreta:
# GOOGLE_APPLICATION_CREDENTIALS_JSON={...}

# ── Document AI ──────────────────────────────
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=your-processor-id-here
# Limite online do process_document (~15 páginas por request)
DOCUMENT_AI_ONLINE_PAGE_LIMIT=15

# ── Google Cloud Storage ─────────────────────
GCS_BUCKET_PROCESSOS=your-bucket-name
GCS_PROCESSOS_PREFIX=processos
# Para dev local sem GCS, usar armazenamento em disco:
STORAGE_BACKEND=local
# LOCAL_STORAGE_PATH=./storage

# ── MongoDB ──────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=omnia
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
PROCESSOS_DIR=../processos
MAX_PROCESSES_PER_CORRECTION=30

# ── Limites ──────────────────────────────────
MAX_PDF_SIZE_MB=100
MAX_PAGES_PER_REQUEST=500
MAX_QUESTIONS_PER_QUESTIONNAIRE=50

# ── Timeouts (segundos) ─────────────────────
OCR_TIMEOUT_SECONDS=300
LLM_TIMEOUT_SECONDS=3600

# ── Observabilidade ──────────────────────────
LOG_LEVEL=INFO
